[Unit]
Description=Check for containers Docker failed to restart after boot

[Timer]
# Late enough that dockerd has finished restoring containers on its own, so
# this only catches the ones it skipped. The repeat covers a dockerd restart
# without a reboot, which can leave containers the same way.
OnBootSec=2min
OnUnitActiveSec=10min
AccuracySec=10s

[Install]
WantedBy=timers.target
